# =============================================================================
#  Quality Core Cutting UAE — environment file
#  Copy to ".env" on the server and fill in the values marked  <-- SET THIS
#  (The site needs no database: sessions/cache use files.)
# =============================================================================

APP_NAME="Quality Core Cutting UAE"
APP_ENV=production
# <-- SET THIS  (php artisan key:generate)
APP_KEY=
APP_DEBUG=false
APP_URL=https://qualitycorecuttinguae.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# No database is used by the website (kept for Laravel's defaults only)
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# --- Email for website enquiries (Hostinger email SMTP) ---
# Until these are set, enquiries are only written to storage/logs.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
# <-- SET THIS (mailbox created in hPanel)
MAIL_USERNAME=info@qualitycorecuttinguae.com
# <-- SET THIS
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@qualitycorecuttinguae.com"
MAIL_FROM_NAME="${APP_NAME}"
ENQUIRY_EMAIL=info@qualitycorecuttinguae.com

# --- SEO / analytics (optional) ---
# Search Console "HTML tag" content value
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
GTAG_ID=GT-PZM4KCD2
GADS_ID=AW-16802235479
