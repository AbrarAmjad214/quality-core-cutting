<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # --- Canonical host: http:// or www → https://qualitycorecuttinguae.com (one hop)
    # Only for the live domain, so localhost / XAMPP is never affected.
    # (Normally the root .htaccess already did this; LiteSpeed sometimes runs
    #  the rules in public/ instead, so they are repeated here.)
    RewriteCond %{HTTP_HOST} ^(www\.)?qualitycorecuttinguae\.com$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^$ https://qualitycorecuttinguae.com/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^(www\.)?qualitycorecuttinguae\.com$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^(.*\.[a-zA-Z0-9]{2,5})$ https://qualitycorecuttinguae.com/$1 [R=301,L,NE]
    RewriteCond %{HTTP_HOST} ^(www\.)?qualitycorecuttinguae\.com$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^(.+?)/?$ https://qualitycorecuttinguae.com/$1/ [R=301,L,NE]

    # --- Backup /public strip (LiteSpeed may process rules here) -----------
    # Uses THE_REQUEST (the original request line) so internal rewrites never loop.
    RewriteCond %{THE_REQUEST} \s/public/?[\s?] [NC]
    RewriteRule ^ / [R=301,L]
    RewriteCond %{THE_REQUEST} \s/public/([^\s?]*\.[a-zA-Z0-9]{2,5})[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/public/([^\s?]*?)/?[\s?] [NC]
    RewriteRule ^ /%1/ [R=301,L,NE]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # NOTE: Laravel's default "Redirect Trailing Slashes" rule was removed on
    # purpose — this site uses trailing-slash URLs (App\Http\Middleware\AddTrailingSlash),
    # and that rule would create a redirect loop.

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ---- Performance: compression ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# ---- Performance: long browser cache for static assets ----
# CSS/JS are linked with ?v=<file time>, so changes still show immediately.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|jpe?g|png|svg|ico|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
